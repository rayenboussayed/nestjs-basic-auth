{
  "name": "nestjs-basic-auth",
  "version": "1.0.0",
  "description": "Minimal, secure NestJS Basic auth module (RFC 7617) — like fastify-basic-auth and Hono's basicAuth middleware.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nestjs",
    "basic-auth",
    "authentication",
    "rfc7617"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docs": "npm run build && mdaics",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:perf": "vitest run test/perf",
    "test:memory": "NODE_OPTIONS=--expose-gc vitest run test/memory",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "prepare": "husky",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "basic-auth": "^3.1.0",
    "jutilities": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^9.0.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/testing": "^12.6.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mdaics": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4"
  }
}
